# Required owner access
APP_ACCESS_TOKEN=replace-with-a-long-random-value
APP_SESSION_SECRET=replace-with-a-different-long-random-value
INGEST_TOKEN=replace-with-a-long-random-value
ALLOW_INSECURE_LOCAL=false

# Optional AI
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-5-mini
REASONING_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small

# Slack
SLACK_BOT_TOKEN=

# Google: use access tokens or the refresh-token set
GMAIL_ACCESS_TOKEN=
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Microsoft Graph: use an access token or the refresh-token set
MICROSOFT_GRAPH_ACCESS_TOKEN=
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REFRESH_TOKEN=
